# Server
NODE_ENV=development
PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
PASSWORD_RESET_RATE_LIMIT_MAX=5

# Email (SMTP) — used to mail password-reset OTP codes.
# Leave SMTP_HOST/USER/PASS empty to run without a mailbox: the OTP is written to
# the server log instead of being sent, and the reset flow still works end-to-end.
#
# Gmail setup:
#   1. Enable 2-Step Verification on the Google account.
#   2. Go to https://myaccount.google.com/apppasswords and create an App Password.
#   3. Put the 16-character App Password in SMTP_PASS (NOT your Gmail password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=rfh2375@gmail.com
SMTP_PASS=swci gufm nofh vnpt
# Optional display name. Gmail rewrites the address to the authenticated account,
# so keep the address the same as SMTP_USER. Defaults to SMTP_USER when empty.
SMTP_FROM=SCM <rfh2375@gmail.com>

# Password-reset OTP policy
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
