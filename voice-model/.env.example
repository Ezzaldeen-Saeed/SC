# ═══════════════════════════════════════════════════════════
#  Real-Time Call Analyzer — مثال الإعدادات (نظام محلي بالكامل)
#  انسخ هذا الملف إلى voice-model/.env واملأ القيم.
#  مفيش أي API خارجي: التفريغ Whisper محلي، والتحليل LM Studio/Ollama محلي.
# ═══════════════════════════════════════════════════════════

# ── Discord ───────────────────────────────────────────────
# توكن البوت من https://discord.com/developers/applications
# فعّل "Message Content Intent" في صفحة Bot.
DISCORD_TOKEN=
# انضمام تلقائي لأي قناة صوتية بمجرد دخول أول شخص (true/false)
AUTO_JOIN=true

# ── Whisper (محرّك التفريغ المحلي الوحيد — faster-whisper) ──────────────────
# النموذج: large-v3 أقوى وأدقّ نسخة للعربية. بدائل أخفّ: medium · small · base · tiny.
WHISPER_MODEL=large-v3
# الجهاز: auto (GPU لو متاح وإلا CPU) · cuda · cpu
WHISPER_DEVICE=auto
# نوع الحساب: فارغ=تلقائي (cuda→int8_float16، cpu→int8).
#   على كارت 8GB يتقاسمه الـ LLM: سيب int8_float16 (~3GB، دقّة كاملة عملياً).
#   لو الكارت مُخصّص لـ Whisper وحده: استخدم float16 (أعلى دقّة، ~4.7GB).
WHISPER_COMPUTE_TYPE=
# لغة التفريغ (Whisper يستخدم رمز ISO عام): ar للعربية (يشمل المصرية).
WHISPER_LANGUAGE=ar
# عدد الحزم: الحيّ صغير للسرعة، التقرير أكبر للدقّة.
WHISPER_BEAM_SIZE=5
WHISPER_REPORT_BEAM=10
# (اختياري) نموذج تقرير أقوى مستقل عن الحيّ — الافتراضي نفس WHISPER_MODEL (تحميل واحد).
# WHISPER_REPORT_MODEL=large-v3
# (اختياري) مسار مجلّد CT2 محلي مُنزَّل مسبقاً — أولوية أعلى من الاسم:
# WHISPER_LOCAL_MODEL_PATH=
# (اختياري) Hotwords للتحيّز لمصطلحات الكول سنتر — فارغ = القائمة الافتراضية في config.py
# (تُدمج تلقائياً مع company_terms من egyptian_dictionary.json القابل للتحرير بدون كود):
# WHISPER_HOTWORDS=فودافون, راوتر, فاتورة, باقة, شكوى

# (اختياري) دقّة Whisper المتقدّمة — القيم الافتراضية مضبوطة للمصري؛ عدّل عند الحاجة:
# WHISPER_BEST_OF=8                    # مرشّحو العيّنات الحرارية (أدقّ/أبطأ قليلاً)
# WHISPER_PATIENCE=2.0                 # صبر البحث الشعاعي (>1 أدقّ)
# WHISPER_REPETITION_PENALTY=1.15      # يقلّل هلوسة التكرار
# WHISPER_WORD_TIMESTAMPS=true         # ثقة كل كلمة (التقرير يفعّلها دائماً؛ false يسرّع الحيّ)
# WHISPER_VAD_MIN_SILENCE_MS=250       # أقصر صمت فاصل (قُلّل للمكالمات السريعة)
# WHISPER_VAD_SPEECH_PAD_MS=400
# WHISPER_INITIAL_PROMPT=              # فارغ = تمهيد مصري افتراضي في config.py
# WHISPER_ADAPTIVE_RETRANSCRIBE=true   # إعادة تفريغ المقاطع منخفضة الثقة فقط (تقرير)
# WHISPER_RETRANSCRIBE_BEAM=10
# WHISPER_RETRANSCRIBE_MAX=12          # سقف عدد المقاطع المُعاد تفريغها (أداء)
# WHISPER_CONF_LOGPROB_MIN=-1.0        # عتبات تحديد الثقة المنخفضة
# WHISPER_CONF_COMPRESSION_MAX=2.4
# WHISPER_CONF_NO_SPEECH_MAX=0.6
# WHISPER_CONF_MIN_WORD_PROB=0.35

# ── تنظيف التفريغ (منظّف حتمي محلي — الخطوة 3) ─────────────────
# ينظّف نص Whisper (تكرار/مسافات/ترقيم + تصحيحات قاموس مصري) مع الحفاظ على اللهجة.
# القاموس قابل للتحرير بدون كود: voice-model/pipeline/dictionary/egyptian_dictionary.json
# أطفئه (false) للرجوع للنص الخام تماماً أو للمقارنة.
TEXT_CLEANER_ENABLED=true
# (اختياري) وجّه القاموس لملف خارجي بدل المرفق مع المشروع:
# SCM_DICTIONARY_PATH=

# ── مفسّر اللهجة المصرية (تلميحات ضمنية للتحليل — الخطوة 4) ──────
# يفهم تعبيرات مصرية (هحاول=التزام ضعيف، هشوف=رد مؤجّل...) ويحقن معناها في البرومبت.
# المعجم قابل للتحرير بدون كود: voice-model/pipeline/dialect/dialect_lexicon.json
DIALECT_INTERPRETER_ENABLED=true
# SCM_DIALECT_LEXICON_PATH=

# ── محرّك المشاعر المصري (قراءة شعورية + خط زمني — الخطوة 8) ─────
# يكتشف ١١ شعوراً من كلام العميل (غضب/إحباط/حيرة/خوف/توتر/رضا/حماس/تردد/تهكّم/استعجال/ثقة)
# ويحقنها في التحليل اللحظي والتقرير. المعجم قابل للتحرير: pipeline/emotion/emotion_lexicon.json
EMOTION_ENGINE_ENABLED=true
# SCM_EMOTION_LEXICON_PATH=

# ── LLM محلي (LM Studio / Ollama عبر OpenAI-compatible API) ────
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:1234/v1
# اسم الموديل زي ما هو ظاهر في LM Studio. Qwen2.5-7B موصى به.
LLM_MODEL=qwen2.5-7b-instruct
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# ── تصحيح نص التفريغ (ASR) بموديل محلي ──────────────────────────
# يصلح أخطاء التعرّف الصوتي من السياق. يحتاج موديل قوي ليُفيد (فعّله بعد تحميل موديل مناسب).
CORRECTION_ENABLED=true
CORRECTION_MODEL=qwen2.5-7b-instruct
CORRECTION_BASE_URL=http://127.0.0.1:1234/v1

# ── (اختياري) توجيه التحليل اللحظي/التقرير لموديل محلي مختلف ────────────────
# اتركها معلّقة = تستخدم نفس LLM_MODEL/OLLAMA_BASE_URL أعلاه (كله محلي).
# REALTIME_BASE_URL=http://127.0.0.1:1234/v1
# REALTIME_MODEL=arabic-orpo-llama-3-8b-instruct
# REPORT_BASE_URL=http://127.0.0.1:1234/v1
# REPORT_MODEL=arabic-orpo-llama-3-8b-instruct

# ── Server ────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080
RELOAD=false
