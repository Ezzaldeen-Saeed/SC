{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start", "--prefix", "backend"],
      "port": 3000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "frontend", "--bind", "127.0.0.1"],
      "port": 5500
    }
  ]
}
